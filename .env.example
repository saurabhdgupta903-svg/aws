# Database (SQLite locally; use a hosted PostgreSQL URL such as RDS, Neon, or Supabase in production)
DATABASE_URL="file:./dev.db"

# AWS Region (Amplify / Bedrock / Rekognition / S3 / SES)
AWS_REGION="ap-south-1"

# Image Analysis Provider: mock | bedrock | rekognition
ANALYZE_PROVIDER="mock"
BEDROCK_MODEL_ID="amazon.nova-lite-v1:0"

# Optional S3 bucket for report photo uploads
S3_BUCKET=""

# Email Alerts (Feature 2): ses | smtp | console
EMAIL_PROVIDER="console"
FROM_EMAIL="alerts@floodloop.example"
APP_BASE_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Safe Routes by Vehicle (Feature 3)
OSRM_BASE_URL="https://router.project-osrm.org"
OSRM_BIKE_BASE_URL=""
OSRM_WALK_BASE_URL=""
ORS_API_KEY=""
ROUTES_CACHE_TTL_MS="300000"

# AI Safety Chatbot (Feature 4) - server-side only
LLM_PROVIDER="gemini"
LLM_API_KEY=""
LLM_MODEL="gemini-2.5-flash"
